# Neon Postgres connection strings. The pooled one serves the app; the direct
# (unpooled) one is used by migrations when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The server's pass-signing key (a private JWK). Generate one with
# `npm run keys:generate`. Never commit it or send it to a client.
PASS_SIGNING_KEY=

# Signs Better Auth's session cookies. Generate one with `openssl rand -base64 32`.
# Required in production; never commit it.
BETTER_AUTH_SECRET=
# The site's own address, e.g. https://salama.example. Defaults to the request's origin in development.
BETTER_AUTH_URL=
