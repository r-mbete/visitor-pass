# Neon Postgres connection strings. The pooled one serves the app; the direct
# (unpooled) one is used by migrations when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The server's pass-signing key (a private JWK). Generate one with
# `npm run keys:generate`. Never commit it or send it to a client.
PASS_SIGNING_KEY=

# The demo gate (/gate, /demo and /api/gate/*) is open in development. Set this
# to "on" to open it in a production build too, until guard sign-in exists.
DEMO_GATE=
